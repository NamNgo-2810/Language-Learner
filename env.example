# Copy this file to .env and fill in your own values. Never commit .env itself.

# Anthropic API key, used server-side only for the "Generate sentence" feature.
ANTHROPIC_API_KEY=sk-ant-...

# Basic Auth credentials - required before deploying anywhere public.
# Leave unset for local-only use (no login prompt).
APP_USERNAME=
APP_PASSWORD=

# Port to listen on (hosts like Render set this automatically).
PORT=8080
