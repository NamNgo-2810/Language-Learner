# Copy this file to .env and fill in your own values. Never commit .env itself.

# No Anthropic API key is needed: every AI feature runs through local-bridge.js
# on your own machine using the Claude Code CLI (see README, "AI features").

# Basic Auth credentials - required before deploying anywhere public.
# Leave unset for local-only use (no login prompt).
APP_USERNAME=
APP_PASSWORD=

# Port to listen on (hosts like Render set this automatically).
PORT=8080

# --- Google Sheets storage (required) ---
# Words are stored in a Google Sheet. The server authenticates with a Google
# service account. Provide the service-account key ONE of two ways:
#
#   1. Inline JSON (best for hosts like Render) — paste the whole key file as a
#      single line (or with literal \n in the private_key; JSON.parse handles it):
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@...iam.gserviceaccount.com", ...}
#
#   2. Path to the key file on disk (handy locally). Keep the file gitignored.
# GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json

# The spreadsheet ID (the long string in the sheet URL between /d/ and /edit).
# You can set it here to override languages.json, or leave it there instead.
# Use GOOGLE_SHEET_ID for a single sheet, or GOOGLE_SHEET_ID_<LANGID> per language.
GOOGLE_SHEET_ID=
# GOOGLE_SHEET_ID_MANDARIN=
